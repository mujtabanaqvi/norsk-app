# Production environment template. Copy the values into your hosting provider's
# environment settings (backend) and EAS environment variables (app). Never commit real values.

# ---------------------------------------------------------------------------
# Backend (Next.js server) - set on the host, e.g. Vercel > Settings > Environment Variables
# ---------------------------------------------------------------------------

NODE_ENV=production

# Neon: pooled connection for the runtime, direct connection for migrations
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Public URL of this backend (verification email links, Better Auth callbacks)
NEXT_PUBLIC_APP_URL=https://api.snakkly.no
BETTER_AUTH_URL=https://api.snakkly.no
REFERRAL_LINK_BASE_URL=https://snakkly.no
# Support address shown in the app, on the legal pages and in emails.
SUPPORT_EMAIL=support@snakkly.no

# Auth secrets: generate each with `openssl rand -base64 48`. Without them the code
# falls back to hard-coded development secrets.
JWT_SECRET=
BETTER_AUTH_SECRET=
ADMIN_SECRET=

# AI (Azure AI Foundry)
AI_PROVIDER=azure
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EVAL_DEPLOYMENT=
STT_PROVIDER=azure-speech

# Only needed when AI_PROVIDER=openai (ElevenLabs is used for TTS only on that route)
# OPENAI_API_KEY=
# ELEVEN_API_KEY=
# ELEVEN_EXAMINER_VOICE_ID=
# ELEVEN_COCANDIDATE_VOICE_ID=

# Google Sign-In: every OAuth client ID whose ID tokens the server accepts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Email (Resend, sender on a verified domain)
RESEND_API_KEY=
EMAIL_FROM="Snakkly <no-reply@snakkly.no>"

# RevenueCat (production project)
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH="Bearer <long-random-string>"

# ---------------------------------------------------------------------------
# App (Expo) - inlined at build time. Set in EAS: expo.dev > project > Environment
# variables > "production" (and "preview"). Public by design: no secrets here.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_API_URL=https://api.snakkly.no
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_
EXPO_PUBLIC_REVENUECAT_WEB_KEY=rcb_
