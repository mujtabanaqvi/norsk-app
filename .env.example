# Pooled connection (used by Next.js runtime & WebSocket transactions)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Direct connection (used by drizzle-kit push / migrate)
DIRECT_DATABASE_URL="postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# AI Provider Toggle ('openai' | 'azure', defaults to 'openai' if unset)
AI_PROVIDER=openai

# Direct OpenAI Configuration
OPENAI_API_KEY=sk-xxxxxxx
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_EVAL_MODEL=gpt-4o
# OPENAI_STT_MODEL=gpt-4o-transcribe

# Azure AI Foundry Configuration (Used when AI_PROVIDER=azure)
# AZURE_OPENAI_RESOURCE_NAME=your-azure-resource-name
# AZURE_OPENAI_API_KEY=your-azure-api-key
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
# AZURE_OPENAI_EVAL_DEPLOYMENT=norsk-eval #gpt-5 is being used for evaluation, but this can be changed to gpt-4o if needed.
# AZURE_OPENAI_WHISPER_DEPLOYMENT=norsk-whisper # whisper is being used for speech-to-text, but this can be changed to gpt-4o-transcribe if needed.
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_ENDPOINT=https://your-foundry-resource.openai.azure.com/

# Speech-to-Text Provider Toggle ('azure-speech' | 'azure-openai' | 'openai')
# When unset, follows AI_PROVIDER: azure -> azure-openai (Whisper deployment), openai -> openai.
# 'azure-speech' uses Azure AI Speech fast transcription (600 RPM default vs 3 RPM for Azure OpenAI Whisper).
STT_PROVIDER=azure-speech

# Optional: If STT is to be used outside of Foundry, you can set the region and endpoint for Azure Speech.
# If using a Foundry resource, these are not needed: Speech uses AZURE_OPENAI_API_KEY and https://<AZURE_OPENAI_RESOURCE_NAME>.cognitiveservices.azure.com automatically
# AZURE_SPEECH_ENDPOINT 
# AZURE_SPEECH_STT_ENDPOINT 

# ElevenLabs TTS
ELEVEN_API_KEY=el_xxxxxxx
ELEVEN_EXAMINER_VOICE_ID=voice_id_1
ELEVEN_COCANDIDATE_VOICE_ID=voice_id_2

ADMIN_SECRET =super_secret_admin_token

# User Authentication & JWT
JWT_SECRET=super_secret_jwt_key_replace_in_production

# Google Sign-In (OAuth client IDs from Google Cloud Console > APIs & Services > Credentials)
# Server: every client ID whose ID tokens /api/auth/google should accept.
GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_web_client_secret
# GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
# GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
# App (inlined by Expo at build time). Native Android/iOS sign-in needs a development build
# (npx expo run:android / run:ios) - Expo Go cannot receive the Google redirect.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com

# Email verification (Resend - https://resend.com/api-keys)
# Without RESEND_API_KEY in development, the code and link are printed to the server console.
RESEND_API_KEY=re_xxxxxxx
# Must be an address on a domain verified in Resend (onboarding@resend.dev only delivers to your own address)
EMAIL_FROM="Snakkly <no-reply@yourdomain.no>"

# Stripe Subscriptions & Billing
STRIPE_SECRET_KEY=sk_test_51xxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxx
# Public base URL - also used for the link in verification emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional overrides (auto-detected on Expo Go / Emulator / Web when omitted):
# EXPO_PUBLIC_API_URL=http://192.168.1.x:3000
# ELEVEN_MODEL_ID=