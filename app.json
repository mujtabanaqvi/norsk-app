{
  "expo": {
    "name": "Snakkly",
    "slug": "norsk-app",
    "scheme": "snakkly",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/brand/snakkly-icon-512.png",
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#BA0C2F",
    "splash": {
      "image": "./assets/brand/snakkly-logo-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "web": {
      "favicon": "./assets/brand/favicon.ico",
      "name": "Snakkly · Norskprøven Muntlig",
      "themeColor": "#BA0C2F",
      "backgroundColor": "#F6F7FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.snakkly.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Norskprøven muntlig simulator trenger tilgang til mikrofonen for å vurdere din muntlige uttale og flyt.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.snakkly.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/snakkly-icon-512.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Norskprøven muntlig simulator trenger tilgang til mikrofonen for å vurdere din muntlige uttale og flyt."
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-web-browser",
      "expo-iap"
    ],
    "extra": {
      "eas": {
        "projectId": "d5e390c5-69b7-4798-b01d-15b3ecb57aab"
      }
    }
  }
}
