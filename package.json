  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.1",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.3",
    "concurrently": "^10.0.6",
