{
  "name": "norsk-app-control-plane",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:all": "concurrently \"npm run dev\" \"npm run mobile:start\"",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/db-schema.test.ts tests/evaluate-exam.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:norskprove": "tsx src/db/seed-norskprove.ts",
    "mobile:start": "expo start",
    "mobile:web": "expo start --web",
    "mobile:android": "expo start --android",
    "mobile:ios": "expo start --ios"
  },
  "dependencies": {
    "@ai-sdk/azure": "^4.0.103",
    "@ai-sdk/openai": "^4.0.84",
    "@apple/app-store-server-library": "^3.1.0",
