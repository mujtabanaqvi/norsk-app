{
  "name": "norsk-app-control-plane",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:all": "concurrently \"npm run dev\" \"npm run mobile:start\"",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/db-schema.test.ts tests/evaluate-exam.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "mobile:start": "expo start",
    "mobile:web": "expo start --web",
    "mobile:android": "expo start --android",
    "mobile:ios": "expo start --ios"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.84",
    "@expo/metro-runtime": "~57.0.16",
    "@neondatabase/serverless": "^1.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@types/ws": "^8.18.2",
    "ai": "^7.0.128",
    "drizzle-orm": "^0.45.3",
    "expo": "^57.0.27",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "next": "^16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "ws": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.3",
    "concurrently": "^10.0.6",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "adm-zip": "^0.6.1",
    "sharp": "^0.35.5",
    "global-agent": "^4.1.3"
